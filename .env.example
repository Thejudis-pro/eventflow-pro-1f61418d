# Copy to .env and fill in real values locally. Never commit .env — it's
# gitignored on purpose. In production (Cloudflare), set these as Worker
# secrets/environment variables instead of relying on this file.

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Real secret, unlike the publishable key above -- bypasses Row Level
# Security entirely. Server-only (src/integrations/supabase/client.server.ts).
# Get it from Supabase Dashboard -> Project Settings -> API -> "service_role"
# (Supabase itself flags it as sensitive there). Never put this in a
# client-visible VITE_ var. NOT currently required to run this app -- the
# payments flow was rewritten to use SECURITY DEFINER RPCs over the public
# anon key instead (see INTERNAL_PAYMENT_SECRET below and
# supabase/migrations/20260816000000_payments_without_service_role.sql),
# specifically because this key isn't reachable through Lovable's managed-
# Supabase UI. Only fill this in if some future server-side feature needs
# genuine RLS-bypass access.
SUPABASE_SERVICE_ROLE_KEY=""

# "mock" (default) simulates a successful payment locally with no real
# provider call — see src/lib/payments/checkout.functions.ts. Only set to
# "live" once PayTech credentials below are configured for real.
PAYMENTS_MODE="mock"

# PayTech (paytech.sn) — never expose these to the client; only read inside
# src/lib/payments/paytech.server.ts via a dynamic import from a server
# function/route handler.
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
PAYTECH_ENV="test"

# Gates the confirm_payment_secure RPC (the only write allowed to mark a
# payment success/failed) -- same shape as a webhook signing secret, since
# Postgres has no other way to tell "my own server, after verifying
# PayTech's signature" apart from "anyone with the public anon key". Must
# match the value inserted by
# supabase/migrations/20260816000000_payments_without_service_role.sql
# exactly, or payment confirmation will fail. Ask Claude if this needs
# rotating -- it can generate a new value and update both places.
INTERNAL_PAYMENT_SECRET=""
